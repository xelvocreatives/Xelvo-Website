# Copy to .env and fill in. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://www.xelvocreatives.com"

# --- MongoDB (Atlas) ---
# Atlas -> Database -> Connect -> Drivers. Include the password in the URI.
MONGODB_URI=""
MONGODB_DB="xelvo"

# --- Cloudinary (image + CV uploads) ---
# Cloudinary Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Admin login (Auth.js) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
ADMIN_EMAIL=""
# Generate with: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=""

# --- Supabase (legacy: kept only until the data copy is done) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
HEALTH_CHECK_TABLE=""
HEALTH_CHECK_SECRET=""
KEEPALIVE_ENABLED=""
KEEPALIVE_INTERVAL_MINUTES=""
KEEPALIVE_URL=""
